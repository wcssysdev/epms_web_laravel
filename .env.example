APP_NAME="EPMS IOI"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://epms-laravel.test:8080
APP_VERSION=1.0.0

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=epms_l
DB_USERNAME=postgres
DB_PASSWORD=
DB_SCHEMA=public

SESSION_DRIVER=file
SESSION_LIFETIME=480
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@epms.ioi"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# HSE Portal REST API key (base URL is stored per-company in m_company_config.hse_api_url)
HSE_PORTAL_API_KEY="Kyv61GnBqNNw0HGnoP/fr8Yme3IhT2oPgpDL2x53gXc="

# estate-db-fusion — source PostgreSQL (12 legacy CI3 estate DBs).
# The database name is selected per source DB at runtime, so FUSION_PG_DATABASE
# is normally left blank. Used only by the fusion:* artisan commands.
FUSION_PG_HOST=127.0.0.1
FUSION_PG_PORT=5432
FUSION_PG_DATABASE=
FUSION_PG_USER=postgres
FUSION_PG_PASSWORD=wilmar123
